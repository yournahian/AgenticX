# ATOMX ENGAGE — SERVER ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=development

# Multi-Provider API Secret Keys (Isolated strictly on server)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud (LPU Ultra-Fast Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Unified Model Hub: Claude, Llama, Mistral, etc.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Database Configuration (Optional: SQLite used by default)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Master Admin Access Key
JWT_SECRET=atomx_super_secret_jwt_key_928374
CORS_ORIGIN=*
ADMIN_ACCESS_KEY=atomx-admin-key-2026

